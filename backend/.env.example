# Copy to .env and fill in real values.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-dev-secret
JWT_SECRET_KEY=change-me-jwt-secret

# Database — Postgres in production, SQLite for local dev (default below)
# Example Postgres URL: postgresql://user:password@localhost:5432/pahadsuraksha
DATABASE_URL=sqlite:///instance/pahadsuraksha.db

# CORS — the Vite dev server origin
FRONTEND_ORIGIN=http://localhost:5173

# OpenWeather (https://openweathermap.org/api) — required for /api/weather
OPENWEATHER_API_KEY=

# Optional: elevation lookups (https://open-elevation.com or similar)
ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# How long a cached weather reading stays valid, in minutes
WEATHER_CACHE_MINUTES=30
